MONGODB_URI=MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_long_random_secre
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhooks_secret
# Optional monthly recurring Price ID. If blank, lib/membership.ts sets PKR 5000/month for new subscriptions.
STRIPE_MEMBERSHIP_PRICE_ID=
# Public site origin for canonical URLs, sitemap and Stripe returns.
# Set your real HTTPS store domain in Vercel Production (no path or trailing query).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private scheduler secret. Set the same value in Vercel
CRON_SECRET=replace_with_a_random_secret_at_least_32_characters

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key_from_service_account_json\n-----END PRIVATE KEY-----\n"

NOTIFICATION_RETENTION_DAYS=30
